{
  "name": "agentthing",
  "private": true,
  "version": "0.8.0",
  "description": "DeskThing app: a Car Thing status board and controller for Claude Code sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andy-iiiiv/agentthing.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev": "npx @deskthing/cli dev --vite",
    "build": "npx @deskthing/cli package",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "simulate": "node scripts/simulate.mjs",
    "preview": "vite preview",
    "standalone": "esbuild scripts/standalone.ts --bundle --platform=node --format=esm --outfile=dist/standalone.mjs --log-level=warning && node dist/standalone.mjs"
  },
  "dependencies": {
    "@deskthing/client": "^0.11.2",
    "@deskthing/server": "^0.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deskthing/cli": "^0.11.15",
    "@deskthing/types": "^0.11.18",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.15"
  }
}
